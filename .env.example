# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never put a real token in THIS file.
#
# These are only for the scripts in this project. The workflows themselves get
# their secrets from n8n's own credential store, never from here.

# HubSpot private app token - see docs/setup-hubspot.md
HUBSPOT_TOKEN=

# The secret the webhook source requires in the X-Webhook-Key header, so that
# only your ad platform (and your test script) can post leads.
WEBHOOK_KEY=

# Where n8n is running.
N8N_URL=http://localhost:5678

# The webhook path of the "Lead source - webhook" workflow.
WEBHOOK_PATH=clearwater-lead

# Telegram alerts bot ("Clearwater Leads") - see docs/setup-telegram.md.
# The workflows read this from n8n's credential store; it is kept here so the
# setup scripts can create that credential and find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq (free) writes the lead scores - https://console.groq.com
GROQ_API_KEY=
